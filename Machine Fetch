#Login to HTB, open Machines page, open Console and paste below:

(async () => {
  // --- Auto-detect token ---
  const token = (() => {
    const val = localStorage.getItem('htb-token');
    if (val && val.startsWith('eyJ')) return val;
    for (const s of [localStorage, sessionStorage]) {
      for (let i = 0; i < s.length; i++) {
        const key = s.key(i);
        const v = s.getItem(key);
        if (v && typeof v === 'string' && v.startsWith('eyJ') && v.length > 100) return v;
      }
    }
    return null;
  })();

  if (!token) { console.error('Token not found'); return; }
  console.log('Token found');

  const base = 'https://labs.hackthebox.com/api/v5/machines';
  const states = ['retired', 'active'];
  let allMachines = [];
  const seenIds = new Set();

  for (const state of states) {
    let page = 1;
    let totalPages = 1;
    const params = new URLSearchParams({
      per_page: 100,
      state: state
    });

    do {
      params.set('page', page);
      const res = await fetch(`${base}?${params}`, {
        headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' }
      });
      if (!res.ok) throw new Error(await res.text());
      const data = await res.json();
      const machines = data.data || data.machines || [];
      for (const m of machines) {
        if (!seenIds.has(m.id)) {
          seenIds.add(m.id);
          allMachines.push(m);
        }
      }
      totalPages = data.meta?.last_page || data.total_pages || 1;
      console.log(`📄 State=${state}, Page ${page}: ${machines.length} machines (unique total: ${allMachines.length})`);
      page++;
    } while (page <= totalPages);
  }

  console.log(`Total unique machines fetched: ${allMachines.length}`);

  // --- Map difficulty (numeric to label) ---
  const getDifficultyLabel = (num) => {
    const d = num / 10;
    if (d < 3.0) return 'Easy';
    if (d < 4.5) return 'Medium';
    if (d < 6.5) return 'Hard';
    return 'Insane';
  };

  // --- Build list ---
  const list = allMachines.map(m => ({
    name: m.name || '',
    os: m.os || 'Unknown',
    difficultyNum: m.difficulty,
    difficulty: getDifficultyLabel(m.difficulty)
  }));

  // --- Sort and interleave ---
  const diffOrder = { 'Easy': 0, 'Medium': 1, 'Hard': 2, 'Insane': 3 };
  list.sort((a, b) => {
    if (diffOrder[a.difficulty] !== diffOrder[b.difficulty])
      return diffOrder[a.difficulty] - diffOrder[b.difficulty];
    if (a.os === 'Windows' && b.os !== 'Windows') return -1;
    if (a.os !== 'Windows' && b.os === 'Windows') return 1;
    return a.name.localeCompare(b.name);
  });

  const grouped = {};
  for (const m of list) {
    if (!grouped[m.difficulty]) grouped[m.difficulty] = [];
    grouped[m.difficulty].push(m);
  }

  const sorted = [];
  for (const diff of ['Easy', 'Medium', 'Hard', 'Insane']) {
    const group = grouped[diff] || [];
    const windows = group.filter(m => m.os === 'Windows');
    const linux = group.filter(m => m.os === 'Linux');
    const other = group.filter(m => m.os !== 'Windows' && m.os !== 'Linux');
    const maxLen = Math.max(windows.length, linux.length);
    const interleaved = [];
    for (let i = 0; i < maxLen; i++) {
      if (i < windows.length) interleaved.push(windows[i]);
      if (i < linux.length) interleaved.push(linux[i]);
    }
    sorted.push(...interleaved, ...other);
  }

  console.log(`Sorted ${sorted.length} machines:`);
  console.table(sorted.map(m => ({ name: m.name, os: m.os, difficulty: m.difficulty })));

  // Optional: copy JSON to clipboard
  // copy(JSON.stringify(sorted, null, 2));
  return sorted;
})();
